{
  "name": "ix-peer-comparison",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "PW_CHANNEL=chrome playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build:check && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
